# Copie para .env e preencha apenas localmente; nunca publique o .env.
# Campos específicos desta instalação permanecem vazios neste modelo.

# Obrigatório para operações/smoke test locais: ID da sua Skill.
OTTO_ALEXA_SKILL_ID=""
# Padrão genérico; ajuste para a região da sua hospedagem.
OTTO_AWS_REGION="us-east-1"
# Opcional: sem nome, a saudação será genérica.
OTTO_RECIPIENT_NAME=""
# Padrão genérico. Mantenha estável enquanto houver lembretes pendentes.
OTTO_REMINDER_TEXT="Este é o aviso de teste do Agente Otto."

# Preencher por projeto. Não altera a identidade do Git automaticamente.
OTTO_GIT_USER_NAME=""
OTTO_GIT_USER_EMAIL=""
OTTO_GITHUB_REPOSITORY=""
# Opcional: caminho da configuração local do gh; não copiar credenciais.
GH_CONFIG_DIR=""
